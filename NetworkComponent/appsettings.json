{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "SqlSugar": {
    "DbType": "SqlServer",
    "ConnectionString": "Server=127.0.0.1;Database=NetworkComponent;Uid=sa;Pwd=your_password;TrustServerCertificate=True;",
    "IsAutoCloseConnection": true,
    "MoreSettings": ""
  },

  "ModbusTcpConfigs": [
    {
      "DeviceCode": "ModbusTcp_Demo",
      "IpAddress": "127.0.0.1",
      "Port": 502,
      "SlaveId": 1,
      "TimeoutMs": 1000,
      "WaitResponse": true
    }
  ],

  "ModbusRtuWithTcpConfigs": [
    {
      "DeviceCode": "ModbusRtu_Demo",
      "IpAddress": "127.0.0.1",
      "Port": 9000,
      "SlaveId": 1,
      "TimeoutMs": 1000,
      "WaitResponse": true
    }
  ],

  "MqttConfigs": [
    {
      "ClientId": "DemoClient",
      "ServerIp": "127.0.0.1",
      "Port": 1883,
      "UserName": "",
      "Password": "",
      "CleanSession": true,
      "KeepAliveSecond": 30
    }
  ],

  "OpcUaConfigs": [
    {
      "DeviceCode": "OpcUa_Demo",
      "EndpointUrl": "opc.tcp://127.0.0.1:4840",
      "SessionName": "NetworkComponentSession",
      "UseSecurity": false,
      "AutoAcceptUntrustedCertificates": true,
      "ConnectTimeoutMs": 10000,
      "OperationTimeoutMs": 15000,
      "UserName": "",
      "Password": ""
    }
  ],

  "SocketConfigs": [
    {
      "DeviceCode": "Socket_Demo",
      "IpAddress": "192.168.3.9",
      "Port": 8899,
      "TimeoutMs": 1000,
      "WaitResponse": true,
      //"Encoding": "UTF-8"
      "Encoding": "GBK"
    }
  ],

  "SocketServerConfigs": [
    {
      "ServerCode": "SocketServer_Demo",
      "IpAddress": "0.0.0.0",
      "Port": 9001,
      "Encoding": "GBK"
    }
  ]
}
